{
	"name": "callscript",
	"version": "0.1.3",
	"type": "module",
	"description": "a tool-calling script language for LLMs - the model authors ONE small script (plain JS, compiled to a validated, bounded, inert JSON plan - never executed) instead of calling tools one at a time. Adapter-based: mount AI SDK tools or plain { name, execute } literals",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vercel-labs/callscript.git"
	},
	"homepage": "https://callscript.dev",
	"author": "Bereket Engida",
	"keywords": [
		"llm",
		"tool-calling",
		"agents",
		"ai-sdk",
		"code-mode",
		"mcp"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./ai-sdk": {
			"types": "./dist/ai-sdk.d.ts",
			"default": "./dist/ai-sdk.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"default": "./dist/mcp.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"acorn": "^8.15.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"ai": ">=5"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"ai": "^7.0.47",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
